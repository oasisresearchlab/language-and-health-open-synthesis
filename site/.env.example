# ---------------------------------------------------------------------------
# Environment variables for the Language Access in Healthcare site.
# Copy to `.env.local` for local dev, and set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
#
# The read-only site (graph, nodes, narratives, about) needs NONE of these.
# They are only required for the two interactive features below.
# ---------------------------------------------------------------------------

# --- Public: which repo "open an issue / PR" links point at --------------
# Used by node pages and the contribute flow. Safe to expose (NEXT_PUBLIC_*).
NEXT_PUBLIC_GITHUB_REPO=oasisresearchlab/language-and-health-open-synthesis

# --- Contribute flow: GitHub OAuth + pull-request creation ---------------
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL:               https://<your-vercel-domain>
#   Authorization callback URL: https://<your-vercel-domain>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must EXACTLY match the OAuth App callback URL above.
GITHUB_OAUTH_REDIRECT_URI=https://<your-vercel-domain>/api/github/callback
# Repo that contributed PRs are opened against.
GITHUB_REPO_OWNER=oasisresearchlab
GITHUB_REPO_NAME=language-and-health-open-synthesis
GITHUB_REPO_BASE_BRANCH=main

# --- On-demand narrative generation (LLM) --------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Review app: central store for the accuracy pass (optional) ----------
# Without these, the review UI falls back to localStorage (per-browser).
# Setup: supabase/README.md. Safe to expose (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
